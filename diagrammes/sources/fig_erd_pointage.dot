digraph G { graph [rankdir=TB, fontname="DejaVu Sans", fontsize=14, labelloc=t, label="", bgcolor="white", nodesep=0.28, ranksep=0.55, pad=0.2, splines=spline, compound=true];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11, fontcolor="#111111"];
edge [color="#1f3a5f", arrowsize=0.8, dir=both, arrowtail=crow, arrowhead=tee, fontname="DejaVu Sans", fontsize=9, fontcolor="#5a6675"];
  teachers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>teachers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
