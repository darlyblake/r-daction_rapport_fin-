digraph G { graph [rankdir=TB, fontname="DejaVu Sans", fontsize=14, labelloc=t, label="", bgcolor="white", nodesep=0.28, ranksep=0.55, pad=0.2, splines=spline, compound=true];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11, fontcolor="#111111"];
edge [color="#1f3a5f", arrowsize=0.8, dir=both, arrowtail=crow, arrowhead=tee, fontname="DejaVu Sans", fontsize=9, fontcolor="#5a6675"];
  students [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>students</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">student_number</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">active</TD></TR></TABLE>>];
  enrollments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">class_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">academic_year_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">tuition_plan_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">funding_source</TD></TR></TABLE>>];
  school_classes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>school_classes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">grade_level_id</TD></TR></TABLE>>];
  grade_levels [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>grade_levels</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
  academic_years [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>academic_years</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
  tuition_plans [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>tuition_plans</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">late_enrollment_billing_policy</TD></TR></TABLE>>];
  tuition_plan_installments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>tuition_plan_installments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">tuition_plan_id</TD></TR></TABLE>>];
  payment_schedules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>payment_schedules</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">enrollment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">amount_due</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">amount_paid</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">payer_type</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">category</TD></TR></TABLE>>];
  payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">enrollment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">amount</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">method</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">payer_type</TD></TR></TABLE>>];
  payment_allocations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>payment_allocations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">payment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">payment_schedule_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">amount</TD></TR></TABLE>>];
