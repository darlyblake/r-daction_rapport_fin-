  student_options [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>student_options</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">option_type</TD></TR></TABLE>>];
enrollments -> students [style=dashed, color="#5a6675"];
enrollments -> school_classes [style=dashed, color="#5a6675"];
enrollments -> academic_years [style=dashed, color="#5a6675"];
enrollments -> tuition_plans [style=dashed, color="#5a6675"];
school_classes -> grade_levels [style=dashed, color="#5a6675"];
tuition_plan_installments -> tuition_plans [style=dashed, color="#5a6675"];
payment_schedules -> enrollments [style=dashed, color="#5a6675"];
payments -> enrollments [style=dashed, color="#5a6675"];
payment_allocations -> payments [style=dashed, color="#5a6675"];
payment_allocations -> payment_schedules [style=dashed, color="#5a6675"];
enrollment_options -> enrollments [style=dashed, color="#5a6675"];
enrollment_options -> student_options [style=dashed, color="#5a6675"];
}