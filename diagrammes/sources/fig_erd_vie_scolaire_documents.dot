  parent_document_requests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>parent_document_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">response_document_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">establishment_id</TD></TR></TABLE>>];
