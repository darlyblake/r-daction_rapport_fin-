digraph G { graph [rankdir=TB, fontname="DejaVu Sans", fontsize=14, labelloc=t, label="", bgcolor="white", nodesep=0.28, ranksep=0.55, pad=0.2, splines=spline, compound=true];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11, fontcolor="#111111"];
edge [color="#1f3a5f", arrowsize=0.8, dir=both, arrowtail=crow, arrowhead=tee, fontname="DejaVu Sans", fontsize=9, fontcolor="#5a6675"];
  students [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>students</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
  subjects [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>subjects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
  attendance_records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>attendance_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">student_id</TD></TR></TABLE>>];
  attendance_justification_requests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>attendance_justification_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">attendance_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">establishment_id</TD></TR></TABLE>>];
  assessments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>assessments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">PK</FONT></TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
  grades [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#1f3a5f"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>grades</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5a6675">FK</FONT></TD><TD ALIGN="LEFT">assessment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">student_id</TD></TR></TABLE>>];
